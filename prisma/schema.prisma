/// Audit log of duplicate customers merged into one (same person, same company).
model CustomerMerge {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  keptCustomerId   String   @map("kept_customer_id") @db.Uuid
  mergedCustomerId String   @map("merged_customer_id") @db.Uuid
  phoneNumber      String   @map("phone_number")
  mergedFields     Json?    @map("merged_fields")
  movedRows        Json?    @map("moved_rows")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId])
  @@index([keptCustomerId])
  @@map("customer_merges")
}

/// Requests from the public /contact form (hosting, setup and support enquiries).
model ContactRequest {
  id               String    @id @default(uuid()) @db.Uuid
  fullName         String    @map("full_name") @db.VarChar(120)
  workEmail        String    @map("work_email") @db.VarChar(254)
  phone            String    @db.VarChar(40)
  companyName      String    @map("company_name") @db.VarChar(160)
  country          String    @db.VarChar(80)
  companyType      String    @map("company_type") @db.VarChar(20)
  employees        String    @db.VarChar(20)
  insuredCustomers String    @map("insured_customers") @db.VarChar(20)
  claimsPerMonth   String    @map("claims_per_month") @db.VarChar(20)
  coverages        String[]
  deployment       String    @db.VarChar(20)
  desiredStart     DateTime? @map("desired_start") @db.Date
  heardFrom        String?   @map("heard_from") @db.VarChar(200)
  message          String    @db.VarChar(5000)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(300)
  handledAt        DateTime? @map("handled_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("contact_requests")
}
