generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Company {
  id                                               String         @id @default(uuid()) @db.Uuid
  name                                             String         @unique
  slug                                             String         @unique
  domain                                           String         @unique
  schema                                           String         @unique
  logoUrl                                          String?        @map("logo_url")
  primaryColor                                     String?        @map("primary_color") @db.VarChar(7)
  botLanguage                                      String         @default("fr") @map("bot_language") @db.VarChar(10)
  /// Default dashboard language for the company's users ("en" | "fr").
  uiLanguage                                       String         @default("en") @map("ui_language") @db.VarChar(10)
  contactEmail                                     String?        @map("contact_email")
  contactPhone                                     String?        @map("contact_phone")
  country                                          String?
  city                                             String?
  address                                          String?
  isActive                                         Boolean        @default(true) @map("is_active")
  createdAt                                        DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                        DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  admins                                           Admin[]
  admins_admins_companyIdTocompanies               Admin[]        @relation("admins_companyIdTocompanies")
  analytics                                        Analytics[]
  chatbotConfig                                    ChatbotConfig?
  claims                                           Claim[]
  conversations                                    Conversation[]
  conversations_conversations_companyIdTocompanies Conversation[] @relation("conversations_companyIdTocompanies")
  customers                                        Customer[]
  customers_customers_companyIdTocompanies         Customer[]     @relation("customers_companyIdTocompanies")
  feedbacks                                        Feedback[]
  settings                                         Setting[]
  claimTypes                                       ClaimType[]
  claimDetectionPrompts                            ClaimDetectionPrompt[]
  integrationSettings                              IntegrationSettings?

  @@map("companies")
}

/// Credentials are encrypted by the application before they are persisted.
/// Never select these fields for a browser response.
model IntegrationSettings {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                  String   @unique @map("company_id") @db.Uuid
  whatsappDisplayNumber      String?  @map("whatsapp_display_number")
  whatsappPhoneNumberId      String?  @map("whatsapp_phone_number_id")
  whatsappAccessTokenCipher  String?  @map("whatsapp_access_token_cipher") @db.Text
  metaAppSecretCipher        String?  @map("meta_app_secret_cipher") @db.Text
  webhookVerifyTokenCipher   String?  @map("webhook_verify_token_cipher") @db.Text
  whatsappBusinessAccountId  String?  @map("whatsapp_business_account_id")
  llmProvider                String?  @map("llm_provider") @db.VarChar(20)
  llmApiKeyCipher            String?  @map("llm_api_key_cipher") @db.Text
  llmModel                   String?  @map("llm_model")
  llmBaseUrl                 String?  @map("llm_base_url")
  /// Public base URL of the Go API as Meta sees it (e.g. an ngrok host). The
  /// webhook path itself is fixed: <publicBaseUrl>/api/v1/whatsapp/webhook.
  publicBaseUrl              String?  @map("public_base_url")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company                    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("integration_settings")
}

model Admin {
  id                                             String            @id @default(uuid()) @db.Uuid
  /// Always lowercased and trimmed (DB CHECK admins_email_lowercase_check), so @unique is case-insensitive.
  email                                          String            @unique
  firstName                                      String            @map("first_name")
  lastName                                       String            @map("last_name")
  passwordHash                                   String            @map("password_hash")
  role                                           String?           @default("ADMIN") @db.VarChar(20)
  isActive                                       Boolean           @default(true) @map("is_active")
  lastLoginAt                                    DateTime?         @map("last_login_at")
  createdAt                                      DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                      DateTime?         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  companyId                                      String            @map("company_id") @db.Uuid
  createdById                                    String?           @map("created_by_id") @db.Uuid
  /// Personal dashboard language override; null = use the company default.
  uiLanguage                                     String?           @map("ui_language") @db.VarChar(10)
  /// Copied into each JWT as "tv"; incrementing it revokes every existing session of this user.
  tokenVersion                                   Int               @default(0) @map("token_version")
  /// The one active sign-in (JWT "sid"). A new login replaces it, so tokens of the
  /// previous session are rejected with code session_replaced. Null = no login yet.
  currentSessionId                               String?           @map("current_session_id") @db.Uuid
  /// Deprecated: never read or written. Access is decided by `role` (lib/users/roles.ts).
  permissions                                    AdminPermissions?
  company                                        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy                                      Admin?            @relation("AdminHierarchy", fields: [createdById], references: [id])
  createdAgents                                  Admin[]           @relation("AdminHierarchy")
  companies_admins_companyIdTocompanies          Company?          @relation("admins_companyIdTocompanies", fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_admins")
  auditLogs                                      AuditLog[]
  audit_logs_audit_logs_admin_idToadmins         AuditLog[]        @relation("audit_logs_admin_idToadmins")
  claimNotes                                     ClaimNote[]
  assignedClaims                                 Claim[]
  refresh_tokens_refresh_tokens_admin_idToadmins RefreshToken[]    @relation("refresh_tokens_admin_idToadmins")
  refreshTokens                                  RefreshToken[]

  @@index([companyId])
  @@index([email])
  @@index([companyId], map: "idx_admins_company_id")
  @@map("admins")
}

/// DEPRECATED and unused. Roles are authoritative (lib/users/roles.ts, lib/middleware.ts);
/// nothing reads or writes this table any more. Kept only so existing databases need no
/// destructive migration; it can be dropped in a later release.
model AdminPermissions {
  id                 String   @id @default(uuid()) @db.Uuid
  adminId            String   @unique @db.Uuid
  canViewClaims      Boolean  @default(true)
  canCreateClaims    Boolean  @default(true)
  canEditClaims      Boolean  @default(true)
  canApproveClaims   Boolean  @default(false)
  canRejectClaims    Boolean  @default(false)
  canDeleteClaims    Boolean  @default(false)
  canViewCustomers   Boolean  @default(true)
  canEditCustomers   Boolean  @default(true)
  canDeleteCustomers Boolean  @default(false)
  canCreateAdmins    Boolean  @default(false)
  canEditAdmins      Boolean  @default(false)
  canDeleteAdmins    Boolean  @default(false)
  canCreateBills     Boolean  @default(false)
  canProcessRefunds  Boolean  @default(false)
  canViewFinancials  Boolean  @default(false)
  canViewAnalytics   Boolean  @default(true)
  canExportData      Boolean  @default(false)
  canManageSettings  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  admin              Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_permissions")
}

model Customer {
  id                                       String         @id @default(uuid()) @db.Uuid
  phoneNumber                              String         @map("phone_number")
  firstName                                String?        @map("first_name")
  lastName                                 String?        @map("last_name")
  email                                    String?
  policyNumber                             String?        @map("policy_number")
  address                                  String?
  birthDate                                DateTime?      @map("birth_date") @db.Date
  licenseNumber                            String?        @map("license_number")
  isActive                                 Boolean        @default(true) @map("is_active")
  createdAt                                DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  companyId                                String         @map("company_id") @db.Uuid
  claims                                   Claim[]
  conversations                            Conversation[]
  company                                  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companies_customers_companyIdTocompanies Company?       @relation("customers_companyIdTocompanies", fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_customers")
  feedbacks                                Feedback[]

  @@unique([phoneNumber, companyId])
  @@index([companyId])
  @@index([phoneNumber])
  @@index([companyId], map: "idx_customers_company_id")
  @@index([phoneNumber], map: "idx_customers_phone_number")
  @@map("customers")
}

model Conversation {
  id                                           String                 @id @default(uuid()) @db.Uuid
  title                                        String?
  isActive                                     Boolean                @default(true) @map("is_active")
  isEscalated                                  Boolean                @default(false) @map("is_escalated")
  isBotPaused                                  Boolean                @default(false) @map("is_bot_paused")
  mode                                         String                 @default("general") @db.VarChar(30)
  modeSetAt                                    DateTime?              @map("mode_set_at") @db.Timestamptz(6)
  pausedBy                                     String?                @map("paused_by") @db.Uuid
  pausedAt                                     DateTime?              @map("paused_at")
  createdAt                                    DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                    DateTime?              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  companyId                                    String                 @map("company_id") @db.Uuid
  customerId                                   String                 @map("customer_id") @db.Uuid
  company                                      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer                                     Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  companies_conversations_companyIdTocompanies Company?               @relation("conversations_companyIdTocompanies", fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_conversations")
  feedbacks                                    Feedback[]
  messages                                     Message[]
  claimDetectionResults                        ClaimDetectionResult[]

  @@index([companyId])
  @@index([customerId])
  @@index([createdAt])
  @@index([isEscalated])
  @@index([isBotPaused])
  @@index([companyId], map: "idx_conversations_company_id")
  @@index([customerId], map: "idx_conversations_customer_id")
  @@map("conversations")
}

model Message {
  id                   String                 @id @default(uuid()) @db.Uuid
  content              String
  role                 String?                @db.VarChar(20)
  metadata             Json?
  createdAt            DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  conversationId       String                 @map("conversation_id") @db.Uuid
  conversation         Conversation           @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_conversations_messages")
  claimDetectionResults ClaimDetectionResult[]

  @@index([conversationId])
  @@index([createdAt])
  @@index([conversationId], map: "idx_messages_conversation_id")
  @@map("messages")
}

model ProcessedMessage {
  id                String   @id @default(uuid()) @db.Uuid
  whatsappMessageId String   @unique @map("whatsapp_message_id")
  phoneNumber       String   @map("phone_number")
  processedAt       DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([whatsappMessageId])
  @@index([phoneNumber])
  @@index([processedAt])
  @@map("processed_messages")
}

model ChatbotConfig {
  id              String    @id @default(uuid()) @db.Uuid
  welcomeMessage  String    @default("Hello! How can I help you today?")
  maxTokens       Int       @default(150)
  temperature     Decimal?  @default(0.7) @db.Decimal
  model           String    @default("gpt-3.5-turbo")
  systemPrompt    String    @default("You are a helpful insurance assistant.")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  companyId       String    @unique @db.Uuid
  welcome_message String?   @default("Hello! How can I help you today?")
  max_tokens      BigInt?   @default(150)
  system_prompt   String?   @default("You are a helpful insurance assistant.")
  is_active       Boolean?  @default(true)
  created_at      DateTime? @db.Timestamptz(6)
  updated_at      DateTime? @db.Timestamptz(6)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("chatbot_configs")
}

model RefreshToken {
  id                                     String    @id @default(uuid()) @db.Uuid
  token                                  String    @unique(map: "idx_refresh_tokens_token")
  expiresAt                              DateTime
  isRevoked                              Boolean   @default(false)
  createdAt                              DateTime  @default(now())
  adminId                                String    @db.Uuid
  expires_at                             DateTime? @db.Timestamptz(6)
  is_revoked                             Boolean?  @default(false)
  created_at                             DateTime? @db.Timestamptz(6)
  admin_id                               String?   @db.Uuid
  admins_refresh_tokens_admin_idToadmins Admin?    @relation("refresh_tokens_admin_idToadmins", fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_admins_refresh_tokens")
  admin                                  Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token])
  @@index([admin_id], map: "idx_refresh_tokens_admin_id")
  @@index([expires_at], map: "idx_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

model AuditLog {
  id                                 String    @id @default(uuid()) @db.Uuid
  action                             String?
  resource                           String
  resourceId                         String?
  oldValues                          Json?
  newValues                          Json?
  ipAddress                          String?
  userAgent                          String?
  createdAt                          DateTime  @default(now())
  adminId                            String    @db.Uuid
  resource_id                        String?
  old_values                         Json?
  new_values                         Json?
  ip_address                         String?
  user_agent                         String?
  created_at                         DateTime? @db.Timestamptz(6)
  admin_id                           String?   @db.Uuid
  admin                              Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  admins_audit_logs_admin_idToadmins Admin?    @relation("audit_logs_admin_idToadmins", fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_admins_audit_logs")

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@index([action], map: "idx_audit_logs_action")
  @@index([admin_id], map: "idx_audit_logs_admin_id")
  @@map("audit_logs")
}

model Claim {
  id              String               @id @default(uuid()) @db.Uuid
  claimNumber     String               @unique
  type            ClaimCategory        @default(AUTO)
  status          ClaimStatus          @default(NEW)
  customerId      String               @db.Uuid
  incidentDate    DateTime?
  /// The customer only knew the date roughly ("around last week").
  incidentDateApproximate Boolean    @default(false)
  /// The customer's own wording of an approximate date.
  incidentDateText String?
  incidentTime    String?
  description     String?
  notes           String?
  botNotes        String?
  estimatedAmount Decimal?             @db.Decimal(10, 2)
  approvedAmount  Decimal?             @db.Decimal(10, 2)
  pdfPath         String?
  /// Language the customer used with the bot (ISO 639-1); PDFs use it.
  language        String?              @db.VarChar(10)
  assignedAdminId String?              @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  approvedAt      DateTime?
  rejectedAt      DateTime?
  completedAt     DateTime?
  companyId       String               @db.Uuid
  autoClaimData   AutoClaimData?
  documents       ClaimDocument[]
  claimNotes      ClaimNote[]          @relation("ClaimNotes")
  statusHistory   ClaimStatusHistory[]
  assignedAdmin   Admin?               @relation(fields: [assignedAdminId], references: [id])
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dynamicClaimData DynamicClaimData?

  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([claimNumber])
  @@index([createdAt])
  @@map("claims")
}

model AutoClaimData {
  id                       String   @id @default(uuid()) @db.Uuid
  claimId                  String   @unique @db.Uuid
  policyNumber             String?
  insuredFullName          String
  phoneNumber              String
  address                  String?
  email                    String?
  birthDate                DateTime?
  licenseNumber            String?
  vehicleMakeModel         String?
  vehicleYear              Int?
  vehicleRegistration      String?
  vehicleVin               String?
  incidentLocation         String?
  roadType                 String?
  otherDriverName          String?
  otherDriverPhone         String?
  otherInsuranceCompany    String?
  otherPolicyNumber        String?
  otherVehicleRegistration String?
  witnessName              String?
  witnessPhone             String?
  policeContacted          String   @default("false")
  policeReportNumber       String?
  damageDescription        String?
  estimatedRepairCost      String?
  injuriesOccurred         String   @default("false")
  injuryDescription        String?
  medicalTreatmentRequired String   @default("false")
  additionalNotes          String?
  totalPhotosUploaded      Int      @default(0)
  
  // WhatsApp Media Fields
  damagePhotos             String[]
  vehiclePhotos            String[]
  policeReportDocument     String[]
  insuranceCardPhoto       String[]
  driverLicensePhoto       String[]
  additionalDocuments      String[]
  
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
  claim                    Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@map("auto_claim_data")
}

model ClaimDocument {
  id         String   @id @default(uuid()) @db.Uuid
  claimId    String   @db.Uuid
  fileName   String
  filePath   String
  fileType   String
  fileSize   Int
  uploadedBy String?
  base64Data String?  @db.Text  // Store base64 encoded file data for PDF generation
  createdAt  DateTime @default(now())
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("claim_documents")
}

model ClaimStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  claimId    String       @db.Uuid
  fromStatus ClaimStatus?
  toStatus   ClaimStatus
  reason     String?
  changedBy  String       @db.Uuid
  changedAt  DateTime     @default(now())
  claim      Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([changedAt])
  @@map("claim_status_history")
}

model ClaimNote {
  id         String   @id @default(uuid()) @db.Uuid
  claimId    String   @db.Uuid
  content    String
  isInternal Boolean  @default(false)
  authorId   String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  author     Admin    @relation(fields: [authorId], references: [id])
  claim      Claim    @relation("ClaimNotes", fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([authorId])
  @@index([createdAt])
  @@map("claim_notes")
}

model Analytics {
  id                       String   @id @default(uuid()) @db.Uuid
  date                     DateTime @db.Date
  totalConversations       Int      @default(0)
  botResolvedConversations Int      @default(0)
  humanEscalations         Int      @default(0)
  avgResponseTime          Float?
  resolutionRate           Float?
  escalationRate           Float?
  totalClaims              Int      @default(0)
  newClaims                Int      @default(0)
  approvedClaims           Int      @default(0)
  rejectedClaims           Int      @default(0)
  completedClaims          Int      @default(0)
  avgClaimProcessingTime   Float?
  avgSatisfactionRating    Float?
  totalFeedbacks           Int      @default(0)
  companyId                String   @db.Uuid
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([date, companyId])
  @@index([companyId])
  @@index([date])
  @@map("analytics")
}

model Feedback {
  id             String         @id @default(uuid()) @db.Uuid
  customerId     String         @db.Uuid
  conversationId String?        @db.Uuid
  rating         FeedbackRating
  comment        String?
  category       String?
  wasEscalated   Boolean        @default(false)
  resolvedByBot  Boolean        @default(true)
  companyId      String         @db.Uuid
  createdAt      DateTime       @default(now())
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation   Conversation?  @relation(fields: [conversationId], references: [id])
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([rating])
  @@index([createdAt])
  @@map("feedbacks")
}

model Setting {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  description  String
  type         String    @default("DOCUMENT") @db.VarChar(20)
  textValue    String?
  documentUrl     String?
  documentContent String?  @db.Text
  boolValue       Boolean?
  isActive        Boolean   @default(true)
  companyId       String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  createdBy       String?   @db.Uuid
  updatedBy       String?   @db.Uuid
  text_value      String?
  document_url    String?
  document_content String? @db.Text
  bool_value      Boolean?
  is_active    Boolean?  @default(true)
  created_at   DateTime? @db.Timestamptz(6)
  updated_at   DateTime? @db.Timestamptz(6)
  created_by   String?   @db.Uuid
  updated_by   String?   @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_companies_settings")

  @@index([companyId])
  @@index([type])
  @@index([isActive])
  @@index([companyId], map: "idx_settings_company_id")
  @@map("settings")
}

// Intelligent Claim System Models

model ClaimType {
  id                     String                    @id @default(uuid()) @db.Uuid
  companyId              String                    @map("company_id") @db.Uuid
  typeName               String                    @map("type_name") @db.VarChar(50)
  displayName            String                    @map("display_name") @db.VarChar(100)
  description            String?
  isActive               Boolean                   @default(true) @map("is_active")
  detectionKeywords      String[]                  @map("detection_keywords")
  confidenceThreshold    Decimal                   @default(0.7) @map("confidence_threshold") @db.Decimal(3,2)
  requiresConfirmation   Boolean                   @default(true) @map("requires_confirmation")
  sortOrder              Int                       @default(0) @map("sort_order")
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  company                Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fields                 ClaimField[]
  detectionPrompts       ClaimDetectionPrompt[]
  detectionResults       ClaimDetectionResult[]
  userSelectedResults    ClaimDetectionResult[]    @relation("UserSelectedClaimType")
  dynamicClaimData       DynamicClaimData[]

  @@unique([companyId, typeName])
  @@index([companyId, isActive])
  @@map("claim_types")
}

model ClaimField {
  id                     String    @id @default(uuid()) @db.Uuid
  claimTypeId            String    @map("claim_type_id") @db.Uuid
  fieldName              String    @map("field_name") @db.VarChar(100)
  displayName            String    @map("display_name") @db.VarChar(200)
  fieldType              String    @map("field_type") @db.VarChar(50)
  isRequired             Boolean   @default(false) @map("is_required")
  isSensitive            Boolean   @default(false) @map("is_sensitive")
  validationRules        Json?     @map("validation_rules")
  defaultValue           String?   @map("default_value")
  helpText               String?   @map("help_text")
  placeholderText        String?   @map("placeholder_text")
  sortOrder              Int       @default(0) @map("sort_order")
  extractionPrompt       String?   @map("extraction_prompt")
  confirmationRequired   Boolean   @default(false) @map("confirmation_required")
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  claimType              ClaimType @relation(fields: [claimTypeId], references: [id], onDelete: Cascade)

  @@unique([claimTypeId, fieldName])
  @@index([claimTypeId, isRequired])
  @@map("claim_fields")
}

model ClaimDetectionPrompt {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  claimTypeId            String?   @map("claim_type_id") @db.Uuid
  promptType             String    @map("prompt_type") @db.VarChar(50)
  language               String    @default("fr") @db.VarChar(10)
  promptTemplate         String    @map("prompt_template")
  confidenceFactors      Json?     @map("confidence_factors")
  fallbackQuestions      String[]  @map("fallback_questions")
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  claimType              ClaimType? @relation(fields: [claimTypeId], references: [id], onDelete: Cascade)

  @@index([companyId, claimTypeId, promptType])
  @@map("claim_detection_prompts")
}

model ClaimDetectionResult {
  id                     String       @id @default(uuid()) @db.Uuid
  conversationId         String       @map("conversation_id") @db.Uuid
  messageId              String?      @map("message_id") @db.Uuid
  detectedClaimTypeId    String?      @map("detected_claim_type_id") @db.Uuid
  confidenceScore        Decimal?     @map("confidence_score") @db.Decimal(4,3)
  detectionFactors       Json?        @map("detection_factors")
  userConfirmed          Boolean?     @map("user_confirmed")
  userSelectedTypeId     String?      @map("user_selected_type_id") @db.Uuid
  autoExtractedData      Json?        @map("auto_extracted_data")
  finalClaimData         Json?        @map("final_claim_data")
  processingStatus       String       @default("pending") @map("processing_status") @db.VarChar(50)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  conversation           Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message                Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  detectedClaimType      ClaimType?   @relation(fields: [detectedClaimTypeId], references: [id], onDelete: SetNull)
  userSelectedClaimType  ClaimType?   @relation("UserSelectedClaimType", fields: [userSelectedTypeId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("claim_detection_results")
}

model DynamicClaimData {
  id                     String    @id @default(uuid()) @db.Uuid
  claimId                String    @unique @map("claim_id") @db.Uuid
  claimTypeId            String    @map("claim_type_id") @db.Uuid
  fieldData              Json      @map("field_data")
  validationStatus       Json?     @map("validation_status")
  completionPercentage   Decimal   @default(0.00) @map("completion_percentage") @db.Decimal(5,2)
  lastUpdatedField       String?   @map("last_updated_field") @db.VarChar(100)
  requiresReview         Boolean   @default(false) @map("requires_review")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  claim                  Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimType              ClaimType @relation(fields: [claimTypeId], references: [id], onDelete: Cascade)

  @@index([claimId, claimTypeId])
  @@map("dynamic_claim_data")
}

