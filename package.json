{
  "name": "rapidos-dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node --require ./scripts/socket-ip.cjs node_modules/next/dist/bin/next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "node --require ./scripts/socket-ip.cjs node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "check:locales": "node scripts/check-locales.mjs",
    "type-check": "tsc --noEmit",
    "test:unit": "node --import tsx --test __tests__/unit/*.test.ts",
    "build:analyze": "ANALYZE=true npm run build",
    "build:production": "npm run type-check && npm run lint && npm run build",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "docker:restart": "docker compose restart",
    "docker:dashboard:build": "docker compose build dashboard",
    "docker:dashboard:rebuild": "docker compose build --no-cache dashboard",
    "cleanup": "node scripts/cleanup-workspace.js",
    "audit:conversations": "node scripts/audit-conversations.js",
    "clear:conversations": "node scripts/clear-conversations.js",
    "export:conversations": "node scripts/export-conversations.js"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@types/jspdf": "^1.3.3",
    "@types/uuid": "^10.0.0",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.3",
    "next": "^14.2.35",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.19.1",
    "rate-limiter-flexible": "^4.0.1",
    "react": "^18",
    "react-dom": "^18",
    "react-pdf": "^10.2.0",
    "redis": "^4.7.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.18",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}
