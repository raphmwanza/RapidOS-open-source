# Copy to .env and replace every "replace-with-..." value.
# .env is gitignored. Never commit real secrets.
# Generate values with e.g. `openssl rand -hex 32` (use hex for passwords so
# they are safe inside connection URLs).

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=rapidos
POSTGRES_USER=rapidos_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Used when running the dashboard/backend directly on the host (npm run dev,
# go run). docker compose builds its own internal URLs (host "postgres").
DATABASE_URL=postgresql://rapidos_admin:replace-with-a-long-random-password@localhost:5432/rapidos
DIRECT_DATABASE_URL=postgresql://rapidos_admin:replace-with-a-long-random-password@localhost:5432/rapidos

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=replace-with-a-long-random-password
# Host-run only; docker compose uses host "redis" internally.
REDIS_URL=redis://:replace-with-a-long-random-password@localhost:6379/0

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=168h
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
BCRYPT_COST=12

# Required: base64-encoded 32-byte AES-256-GCM key for per-company integration
# settings (`openssl rand -base64 32`). Changing it makes saved settings unreadable.
ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Shared secret for dashboard <-> backend service calls.
INTERNAL_API_KEY=replace-with-a-long-random-internal-key
BACKEND_API_KEY=

# --- URLs / ports -----------------------------------------------------------
# Browser origins allowed to call the Go API directly (comma-separated full origins or hosts).
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_PORT=8080
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Optional: public HTTPS base URL of the Go API as Meta sees it (e.g. an ngrok host).
# Default for Settings > WhatsApp; each company can override it there.
PUBLIC_API_URL=
# Host-run dashboard only (docker compose sets BACKEND_URL=http://api:8080).
BACKEND_URL=http://localhost:8080
# Host ports published by docker compose (bound to 127.0.0.1).
DASHBOARD_HOST_PORT=3000
API_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
# Company signups allowed per client IP per hour (dashboard /api/signup).
SIGNUP_RATE_LIMIT_PER_HOUR=5
# Client IP used by the login/signup rate limits. Leave empty (default) to ignore
# X-Forwarded-For and use the TCP peer address, so clients cannot spoof their IP.
# Set to `true` (one proxy) or a hop count (e.g. 2) ONLY when the dashboard is reachable
# solely through reverse proxies you control that append to X-Forwarded-For.
TRUSTED_PROXY=
# Per-account lockout: after LOGIN_MAX_FAILURES failed sign-ins (any IP) the account
# is locked for LOGIN_LOCKOUT_MINUTES. An admin password reset clears the lock.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Requests allowed per client IP per hour on the public /contact form.
CONTACT_RATE_LIMIT_PER_HOUR=5
LOG_LEVEL=info

# --- Optional single-tenant fallbacks ---------------------------------------
# Prefer per-company values in the dashboard (Settings -> Integrations).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_APP_SECRET=
# gemini | openai | deepseek | qwen | openai-compatible
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Seconds allowed for one LLM request (local models on slow hardware may need more).
LLM_TIMEOUT=90
